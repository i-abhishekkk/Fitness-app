# Firebase Web SDK config — from Firebase Console > Project settings > Your apps > Web app.
# Copy this file to .env.local for local dev (gitignored). In CI/GitHub Pages, these are
# provided as repository secrets instead — see .github/workflows/deploy.yml.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
